            font-size: 18px;
            margin-bottom: 20px;
            color: #dddddd;
        }

        .menu {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 10px;
        }

        .menu a {
            display: block;
            padding: 15px 18px;

            background: #191919;
            border: 1px solid #333333;

            color: #dddddd;
            text-decoration: none;

            font-size: 13px;

            transition: 0.2s;
        }

        .menu a:hover {
            background: #252525;
            border-color: #666666;
            color: #ffffff;
            transform: translateX(3px);
        }

        .section {
            margin-top: 40px;
        }

        .section-title {
            font-size: 13px;
            color: #888888;
            margin-bottom: 12px;
