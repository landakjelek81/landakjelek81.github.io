* {
    box-sizing: border-box;
}

body {
    margin: 0;
    font-family: Arial, Helvetica, sans-serif;
    background: #ffffff;
    color: #333;
}


/* =========================
   HEADER
========================= */

.header {
    height: 65px;
    border-bottom: 1px solid #eeeeee;

    display: flex;
    align-items: center;
    justify-content: space-between;

    padding: 0 5%;
}

.logo {
    font-size: 22px;
    font-weight: bold;
    color: #b0005b;
}

.header nav {
    display: flex;
    gap: 30px;
}

.header nav a {
    text-decoration: none;
    color: #555;
    font-size: 14px;
}


/* =========================
   HALAMAN PRODUK
========================= */

.container {
    width: 95%;
    max-width: 1200px;

    margin: 20px auto;

    display: grid;

    grid-template-columns:
        185px 1fr;

    gap: 25px;
}


/* SIDEBAR */

.sidebar h3 {
    font-size: 16px;

    margin-top: 0;

    padding-bottom: 10px;

    border-bottom:
        1px solid #555;
}

.filter-box {
    background: #fafafa;

    padding: 15px;

    font-size: 12px;
}

.filter-box h4 {
    margin-top: 0;

    font-size: 12px;
}

.filter-box label {
    display: block;

    margin: 9px 0;

    color: #555;
}

.filter-box input {
    margin-right: 6px;
}


/* SORT */

.sort {
    height: 35px;

    display: flex;

    justify-content:
        flex-end;

    align-items: center;

    font-size: 12px;

    margin-bottom: 5px;
}

.sort select {
    border: 0;

    margin-left: 5px;

    font-size: 12px;

    background: white;
}


/* =========================
   GRID PRODUK
========================= */

.product-grid {

    display: grid;

    grid-template-columns:
        repeat(3, 1fr);

    gap: 20px 10px;
}


.product-card {

    border: 1px solid #e5e5e5;

    min-height: 295px;

    padding: 10px;

    text-align: center;

    text-decoration: none;

    color: #333;

    transition:
        0.2s;
}

.product-card:hover {

    box-shadow:
        0 5px 15px
        rgba(0,0,0,.08);

    transform:
        translateY(-2px);
}


/* GAMBAR */

.product-image {

    height: 165px;

    display: flex;

    justify-content:
        center;

    align-items:
        center;

    overflow: hidden;
}

.product-image img {

    width: 100%;

    height: 100%;

    object-fit: contain;
}


/* JUDUL */

.product-card h3 {

    font-size: 10px;

    line-height: 1.3;

    margin:
        5px 0;

    color: #111;
}


/* KATEGORI */

.category {

    font-size: 8px;

    color: #888;

    display: block;

    margin-bottom: 7px;
}


/* DESKRIPSI */

.product-card p {

    font-size: 8px;

    line-height: 1.4;

    height: 30px;

    overflow: hidden;

    margin:
        0 5px 8px;
}


/* HARGA */

.product-card strong {

    font-size: 10px;

    color: #111;
}


/* =========================
   DETAIL PRODUK
========================= */

.detail-container {

    width: 94%;

    max-width: 1100px;

    margin:
        15px auto;
}


/* BREADCRUMB */

.breadcrumb {

    font-size: 10px;

    color: #777;

    margin-bottom: 20px;
}

.breadcrumb a {

    text-decoration: none;

    color: #777;
}


/* DETAIL */

.product-detail {

    display: grid;

    grid-template-columns:
        55% 45%;

    min-height: 430px;
}


/* GAMBAR BESAR */

.detail-image {

    display: flex;

    justify-content:
        center;

    align-items:
        center;

    padding: 20px;
}

.detail-image img {

    width: 90%;

    height: 400px;

    object-fit: contain;
}


/* INFO */

.detail-info {

    padding:
        10px 30px;
}

.detail-info h1 {

    font-size: 20px;

    line-height: 1.25;

    color: #b0005b;

    margin:
        0 0 10px;
}

.detail-category {

    font-size: 11px;

    font-weight: bold;

    margin-bottom: 8px;
}

.bpom {

    display: flex;

    gap: 8px;

    font-size: 9px;

    color: #777;

    margin-bottom: 12px;
}

.detail-info p {

    font-size: 11px;

    line-height: 1.6;

    color: #555;
}

.price {

    font-size: 14px;

    font-weight: bold;

    margin-top: 25px;

    color: #111;
}

.weight {

    font-size: 11px;

    margin-top: 18px;

    padding-bottom: 10px;

    border-bottom:
        1px solid #777;
}


/* BUTTON */

.buy-button {

    margin-top: 20px;

    padding:
        12px 25px;

    border: 0;

    background: #b0005b;

    color: white;

    cursor: pointer;

    font-size: 11px;
}

.buy-button:hover {

    background: #8c0048;
}


/* =========================
   TABS
========================= */

.tabs {

    display: flex;

    gap: 50px;

    border-bottom:
        1px solid #aaa;

    margin-top: 10px;
}

.tab {

    background: none;

    border: none;

    padding:
        12px 0;

    font-size: 11px;

    cursor: pointer;
}

.tab.active {

    color: #b0005b;

    font-weight: bold;
}


/* DETAIL CONTENT */

.detail-content {

    padding:
        15px 10px;
}

.detail-content h3 {

    color: #b0005b;

    font-size: 11px;
}

.detail-content p {

    font-size: 10px;

    line-height: 1.7;

    color: #444;
}


/* =========================
   RESPONSIVE
========================= */

@media
(max-width: 768px) {


    .container {

        grid-template-columns:
            1fr;
    }


    .sidebar {

        display: none;
    }


    .product-grid {

        grid-template-columns:
            repeat(2, 1fr);
    }


    .product-detail {

        grid-template-columns:
            1fr;
    }


    .detail-image img {

        height: 300px;
    }


    .detail-info {

        padding: 20px;
    }


    .tabs {

        gap: 15px;

        overflow-x: auto;

        white-space: nowrap;
    }

}


@media
(max-width: 450px) {

    .product-grid {

        grid-template-columns:
            1fr;
    }

}
