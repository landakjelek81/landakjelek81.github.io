            color: #aaaaaa;
            text-decoration: none;

            border-bottom: 1px solid #292929;

            font-size: 12px;
        }

        .other-menu a:hover {
            color: #ffffff;
            padding-left: 20px;
        }

        footer {
            margin-top: 60px;
            padding: 20px;

            text-align: center;

            border-top: 1px solid #292929;

            font-size: 11px;
            color: #666666;
        }

        @media (max-width: 600px) {

            .container {
                width: 90%;
            }

            .menu {
